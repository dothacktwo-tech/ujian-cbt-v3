# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
VITE_API_URL="" # Set if backend and frontend are hosted separately, default is relative paths

# ==========================================
# BACKEND & DATABASE CONFIGURATION (PRIVATE / SECURE)
# ==========================================
# Supabase credentials (used for media bucket & sync)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# PostgreSQL connection (Primary production database)
PGHOST="db.your-project.supabase.co"
PGPORT=5432
PGDATABASE="postgres"
PGUSER="postgres"
PGPASSWORD="your-supabase-db-password"

# Alternatively, configure using a full database URL string:
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# JWT and authentication secrets
SESSION_SECRET="generate-a-secure-random-secret"
