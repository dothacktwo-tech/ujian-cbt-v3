# ==========================================
# CBT UJIAN - ENVIRONMENT TEMPLATE (.env.example)
# Salin file ini menjadi .env untuk lokal development
# Atau masukkan variabel ini ke Settings -> Environment Variables di Vercel
# ==========================================

# Port backend dev server (default: 3000)
PORT=3000

# ==========================================
# SUPABASE CONFIGURATION
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
# ==========================================
SUPABASE_URL="https://nsieuoxrzanautfecwtu.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_89VoytPqC6px_JJ0lXvwSQ_4ieorHC1"

# Client-side Supabase credentials (untuk Vercel/Vite client bundle)
VITE_SUPABASE_URL="https://nsieuoxrzanautfecwtu.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_89VoytPqC6px_JJ0lXvwSQ_4ieorHC1"

# ==========================================
# POSTGRESQL DATABASE CONFIGURATION (SERVER ONLY)
# Dapatkan dari Dashboard Supabase -> Project Settings -> Database -> Connection string
# Disarankan mode: URI Pooler (Transaction / Session)
# ==========================================
DATABASE_URL="postgresql://postgres.nsieuoxrzanautfecwtu:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Parameter alternatif jika tidak menggunakan full DATABASE_URL:
PGHOST="aws-0-ap-south-1.pooler.supabase.com"
PGPORT=6543
PGDATABASE="postgres"
PGUSER="postgres.nsieuoxrzanautfecwtu"
PGPASSWORD="your-supabase-db-password"
SUPABASE_DB_PASSWORD="your-supabase-db-password"
