# ==========================================
# CBT UJIAN - ENVIRONMENT TEMPLATE (.env.example)
# Salin file ini menjadi .env untuk lokal development
# Atau masukkan variabel ini ke Settings -> Environment Variables di Vercel
# ==========================================

# Port backend dev server (default: 3000)
PORT=3000

# Frontend API URL (kosongkan jika frontend dan backend satu domain)
VITE_API_URL=""

# Kunci rahasia enkripsi sesi auth / JWT token
SESSION_SECRET="cbt-super-secure-random-session-secret-key-replace-me"

# ==========================================
# SUPABASE CONFIGURATION
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
# ==========================================
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Client-side Supabase credentials (untuk Vercel client bundle)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# ==========================================
# POSTGRESQL DATABASE CONFIGURATION (SERVER ONLY)
# Dapatkan dari Dashboard Supabase -> Project Settings -> Database -> Connection string
# Disarankan mode: URI Pooler (Transaction / Session)
# ==========================================
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Parameter alternatif jika tidak menggunakan full DATABASE_URL:
PGHOST="aws-0-[REGION].pooler.supabase.com"
PGPORT=5432
PGDATABASE="postgres"
PGUSER="postgres.[PROJECT-REF]"
PGPASSWORD="your-supabase-db-password"
